# ============================================================
# API Keys & Secrets — 複製此檔為 .env 後填入實際數值
# .env 已被 .gitignore 排除，永不提交
# ============================================================
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token...
TELEGRAM_CHAT_ID=0000000000

# --- DeepSeek LLM（已停用：本系統為零 LLM 管線）---
# Obtain from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
# 選用：指定模型（預設 deepseek-v4-pro）
# DEEPSEEK_MODEL=deepseek-v4-pro
# 選用：自訂端點（預設 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- FRED API (Federal Reserve Economic Data) ---
# Free tier: https://fred.stlouisfed.org/docs/api/api_key.html
# 用於每日 Brent / WTI 現貨油價監測（120 requests/minute）
FRED_API_KEY=

# --- Marketaux (Financial News API) ---
# Free tier: https://www.marketaux.com/ (100 articles/day)
MARKETAUX_API_KEY=

# --- Finnhub (Backup News & Market Data) ---
# Free tier: https://finnhub.io/register (60 requests/min)
FINNHUB_API_KEY=

# --- Alpha Vantage (Backup Technical Data) ---
# Free tier: https://www.alphavantage.co/support/#api-key (25 requests/day)
ALPHA_VANTAGE_API_KEY=

# --- Bot Configuration ---
# 每輪最多推播幾則（避免刷頻、控制 LLM 成本）
MAX_ALERTS_PER_RUN=5
# Default lookback period for macro data in months
MACRO_LOOKBACK_MONTHS=12
# Default news article limit per ticker
NEWS_ARTICLE_LIMIT=5
# Marketaux 查詢詞（逗號分隔，每組 = 1 次 API 請求；免費額度 100 次/日）
# 建議：查詢詞數 × 每日輪數 <= 96（例：2 組詞 + 每小時 1 輪 = 48 次/日）
MARKETAUX_QUERIES=crude oil,OPEC
# FRED 油價監測：Brent/WTI 單日波動達幾 % 才推播快報（預設 2.5）
PRICE_ALERT_THRESHOLD_PCT=2.5
# 主題冷卻：同主題新聞在此秒數內出現第 3 則起自動壓制（預設 3600）
TOPIC_COOLDOWN_SECONDS=3600
# ============================================================
# Binance 即時訂單流（唯一權威市場資料源；零 LLM）
# ============================================================
# 合約代碼（Binance USDT-M 永續；CLUSDT = 原油，OILUSDT 為無效代碼）
BINANCE_SYMBOL=CLUSDT
# 單筆主動吃單門檻（美元；預設 500000 = $500k）
ORDERFLOW_BLOCK_USD=500000
# 15 秒滾動窗口內同方向累計門檻（美元；預設 1000000 = $1M）
ORDERFLOW_WINDOW_USD=1000000
# 滾動窗口秒數
ORDERFLOW_WINDOW_SEC=15
# 距 24h 高／低點百分比內才發訊（%）
ORDERFLOW_SR_PROXIMITY_PCT=0.3
# ATR 週期與止損倍數（進場 ± N×ATR）
ORDERFLOW_ATR_PERIOD=14
ORDERFLOW_ATR_MULT=1.5
# ATR 計算用 K 線週期與 24h 高低/ATR 背景刷新間隔（秒）
ORDERFLOW_KLINE_INTERVAL=15m
ORDERFLOW_TA_REFRESH_SEC=300
# 每方向獨立冷卻秒數（避免同波連續刷頻）
ORDERFLOW_COOLDOWN_SEC=60
# 全域最小警報間隔（秒；任何方向，防連環刷頻——越大越安靜）
ORDERFLOW_MIN_GAP_SEC=300
# 同方向再次警報所需最小價格推移（%；避免同價位反覆觸發）
ORDERFLOW_MIN_MOVE_PCT=0.12
# 行情基準（24h 高低/ATR）最大容忍年齡（秒；超過則暫停發訊）
ORDERFLOW_SNAPSHOT_MAX_AGE_SEC=1800
# CFTC 週度淨持倉變化門檻（口；0 = 每次新報告都推播）
CFTC_FLOW_THRESHOLD=0
# CFTC 檢查最小間隔（秒，避免盤中每輪都打 Socrata）
CFTC_CHECK_INTERVAL_SEC=1800
# 即時新聞：時間窗（分鐘）與內文段落數
NEWS_MAX_AGE_MINUTES=20
ARTICLE_PARAGRAPH_LIMIT=3
# 翻譯目標語言與 Marketaux 輪詢最小間隔（秒）
TRANSLATE_TARGET=zh-TW
MARKETAUX_MIN_INTERVAL_SEC=1800
# Render 背景輪詢間隔（秒；僅 --serve / uvicorn 模式使用）
LOOP_INTERVAL_SECONDS=300
# HTTP/SOCKS5 proxy for Telegram API (leave empty if direct connection works)
# Example: http://127.0.0.1:7890  or  socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=
# 資料來源（FRED / Marketaux / Finnhub）代理；留空表示直連
# 若健檢顯示資料源連線失敗，可填入與 Telegram 相同的代理
DATA_PROXY_URL=
# Log level: DEBUG shows detailed fetch/generate logs; INFO is quieter
LOG_LEVEL=INFO
# Path to Futu OpenD executable (leave empty to skip auto-launch)
# 保留欄位：未來串接 Futu 即時報價時使用
FUTU_OPEND_PATH=
